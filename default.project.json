{
  "name": "AstralHeist",
  "tree": {
    "$className": "DataModel",
    "ReplicatedFirst": {
      "$className": "ReplicatedFirst",
      "$path": "src/ReplicatedFirst"
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/ReplicatedStorage/Shared"
      },
      "Assets": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "HeroModels": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "Props": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/ServerScriptService/Server"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "$ignoreUnknownInstances": true,
      "NaturePack": {
        "$path": "assets/nature/NaturePack.rbxm"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "CameraMaxZoomDistance": 90,
        "CameraMinZoomDistance": 6,
        "CharacterWalkSpeed": 18,
        "CharacterJumpPower": 52,
        "CharacterUseJumpPower": true
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/StarterPlayer/StarterPlayerScripts/Client"
        }
      },
      "StarterCharacterScripts": {
        "$className": "StarterCharacterScripts",
        "$path": "src/StarterPlayer/StarterCharacterScripts"
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "$properties": {
        "ResetPlayerGuiOnSpawn": false,
        "ScreenOrientation": "LandscapeSensor"
      }
    },
    "Players": {
      "$className": "Players",
      "$properties": {
        "RespawnTime": 5
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": true,
        "StreamingTargetRadius": 900,
        "StreamingMinRadius": 220,
        "Gravity": 196.2,
        "FallenPartsDestroyHeight": -400
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future",
        "Brightness": 2.6,
        "ClockTime": 13.5,
        "GlobalShadows": true,
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 1,
        "ShadowSoftness": 0.25,
        "OutdoorAmbient": [
          0.5,
          0.5,
          0.58
        ],
        "Ambient": [
          0.27,
          0.27,
          0.33
        ]
      }
    },
    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true
      }
    },
    "LocalizationService": {
      "$className": "LocalizationService",
      "$path": "src/LocalizationService"
    }
  }
}
